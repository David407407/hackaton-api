@baseUrl = http://localhost:4000/api
# Si ya lo estás probando directo en la nube de Render, usa tu URL de Render:
# @baseUrl = https://tu-proyecto.onrender.com/api

### ==========================================
### 1. PROBAR USUARIOS (Enfermeros)
### ==========================================

### Crear un usuario con los campos nuevos (Turno Enum)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "nombre": "Enf. Laura Medina",
  "email": "laura.medina@casadelsol.mx",
  "usuario": "laura_medina",
  "password": "securepassword123",
  "turno": "Matutino"
}

### Obtener lista de usuarios
GET {{baseUrl}}/users


### ==========================================
### 2. PROBAR PASTILLAS (Inventario / Slots)
### ==========================================

### Crear una pastilla (Slot 1, con stock inicial y horas)
POST {{baseUrl}}/pills
Content-Type: application/json

{
  "nombre": "Metformina",
  "dosis": "850 mg",
  "forma": "Tableta",
  "slotCompartimento": 1,
  "stockActual": 30,
  "stockMinimoAlerta": 5,
  "capacidad": 30,
  "notas": "Con alimentos",
  "fechaInicio": "2026-09-26T00:00:00.000Z",
  "recurrencia": {
    "tipo": "intervalo",
    "intervaloHoras": 8,
    "horas": ["08:00", "14:00", "22:00"]
  }
}

### Obtener lista de pastillas
GET {{baseUrl}}/pills


### ==========================================
### 3. PROBAR PACIENTES (Con Colores Enum y Género)
### ==========================================

### Crear un paciente (Asegúrate de poner un ID de pastilla válido de arriba)
POST {{baseUrl}}/patients
Content-Type: application/json

{
  "nombre": "Carmen Ruiz",
  "edad": 82,
  "genero": "Femenino",
  "colorTarjeta": "Azul",
  "avatar": {
    "peinado": "chongo",
    "lentes": true,
    "barba": false,
    "bigote": false,
    "colorPiel": "#e8b894",
    "colorCabello": "#ebe7e1",
    "colorRopa": "#4a6eb0",
    "colorFondo": "#cfe9ea"
  },
  "porcentajeAdherencia": 96,
  "pastillas": [
    "6ab7647ef90063d37df0c130"
  ]
}

### ==========================================
### 4. PROBAR ASIGNACIONES (Pastillas y horarios por paciente)
### ==========================================

### Asignar una pastilla a un paciente (usa IDs reales de arriba)
POST {{baseUrl}}/assignments
Content-Type: application/json

{
  "pacienteId": "ID_DEL_PACIENTE",
  "pastillaId": "ID_DE_LA_PASTILLA",
  "cantidad": 1,
  "horas": ["08:00", "20:00"],
  "frecuencia": "dias_especificos",
  "dias": [1, 3, 5],
  "fechaInicio": "2026-09-26",
  "fechaFin": null,
  "indicaciones": "Con alimentos",
  "activa": true
}

### Asignaciones de un paciente
GET {{baseUrl}}/assignments?pacienteId=ID_DEL_PACIENTE

### Obtener pacientes con sus pastillas "populadas"
### Crear usuario 1
POST http://localhost:3000/api/users
Content-Type: application/json

{
  "nombre": "Nombre Apellido",
  "email": "usuario1@ejemplo.com",
  "usuario": "usuario1",
  "password": "contraseñaSegura123",
  "turno": "Matutino"
}

### Crear usuario 2
POST http://localhost:4000/api/users
Content-Type: application/json

{
  "nombre": "Nombre Apellido",
  "email": "usuario1@ejemplo.com",
  "usuario": "usuario1",
  "password": "contraseñaSegura123",
  "turno": "Matutino"
}

### ==========================================
### 5. ARDUINO (dispensador)
### ==========================================
### Pedir la siguiente toma (la deja reservada, no descuenta stock)
GET {{baseUrl}}/tasks/next

### Confirmar que el servo ya giró (marca entregada y descuenta stock)
POST {{baseUrl}}/tasks/ID_DE_LA_TAREA/confirmar

### Última conexión del dispensador (para "Hardware en línea")
GET {{baseUrl}}/tasks/estado
